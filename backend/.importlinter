# Enforces the dependency rules in docs/architecture/01-repository-structure.md s5
# and ADR-003 (the LLM boundary). CI fails on any violation.
#
# INI format (import-linter parses `.importlinter` as INI, not TOML - a
# `pyproject.toml`-based `[tool.importlinter]` config uses TOML instead).
#
# M3 note: mindtrace.{domain,events,engines,api,config} exist now. `engines`
# alone is permitted numpy/scipy (docs/architecture/01-repository-structure.md
# s3: "engines -> domain + numpy") though M3 does not actually import it - see
# the M3 final report's "numerical precision" note. The layered contract lists
# the modules present today; expand it as services/db/... land in M4+.
#
# M5 note: mindtrace.llm exists now (ADR-003). It sits beside engines/events
# in the layered contract - depends only on domain, never on engines (it must
# not be able to make a decision) or on persistence/API layers. Only
# mindtrace.llm.providers is meant to eventually import a real provider SDK
# (provider-sdks-isolated already exempts all of mindtrace.llm by omission);
# M5 ships only a network-free fake provider, so no such import exists yet.
#
# M6-B note: mindtrace.orchestration exists now - the first layer allowed to
# import engines/llm together (it composes them; they never import it or
# each other). Still no persistence/API/frameworks: orchestration-is-
# contained forbids mindtrace.events too (no event sourcing in M6-B's
# in-memory pipeline).
#
# M6-Persistence/Foundation note: mindtrace.db and mindtrace.security exist
# now (ADR-009). Both sit in the same layer-1 tier as engines/events/llm -
# `db` is the only module permitted `sqlalchemy`/`alembic`; `security` is
# the only module (besides the future KMS adapter) permitted to touch key
# material. Per ADR-009, `db` and `security` are mutually isolated: `db`
# needs a `KeyProvider` but takes it as a Protocol parameter rather than
# importing `security.keyring` directly, so neither ever imports the other -
# db-is-contained/security-is-contained enforce this in both directions.
#
# M6-API note: mindtrace.services exists now (`memory_service`,
# `decision_service`, `auth_service`) - layer 2, coordinating `db`/
# `security`/`events` behind the HTTP boundary. It never imports
# `mindtrace.orchestration` (M6-API must not call `orchestration.simulate()`
# - that is M7's job), never `mindtrace.engines`/`mindtrace.llm` (no
# simulation math in M6), and never `sqlalchemy` directly (SQL stays in
# `db/repositories/`). `mindtrace.api` gets its own contract for the first
# time too: no `sqlalchemy`/`mindtrace.db` in routers (`services/` is the
# only caller of `db/`), no `mindtrace.orchestration`/`mindtrace.engines`/
# `mindtrace.llm` (`security.auth` is the one exception - token
# verification is an API-boundary concern the docs place in `security/`).

[importlinter]
root_package = mindtrace
include_external_packages = True

[importlinter:contract:domain-is-pure]
name = Domain is pure: no frameworks, no outward mindtrace imports
type = forbidden
source_modules =
    mindtrace.domain
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    numpy
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.engines
    mindtrace.events
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:events-is-pure]
name = Events depends only on domain: no frameworks, no outward mindtrace imports
type = forbidden
source_modules =
    mindtrace.events
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    numpy
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.engines
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:engines-is-pure]
name = Engines depend only on domain (+ numpy/scipy): no frameworks, no persistence, no LLM
type = forbidden
source_modules =
    mindtrace.engines
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.events
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:llm-is-contained]
name = LLM boundary depends only on domain: no deterministic engines, no persistence, no API
type = forbidden
source_modules =
    mindtrace.llm
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    langchain
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.engines
    mindtrace.events
    mindtrace.orchestration
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:orchestration-is-contained]
name = Orchestration depends on domain/engines/llm only: no frameworks, no persistence, no API
type = forbidden
source_modules =
    mindtrace.orchestration
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.events
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:config-is-thin]
name = Config stays thin: only depends on domain
type = forbidden
source_modules =
    mindtrace.config
forbidden_modules =
    fastapi
    sqlalchemy
    anthropic
    openai
    mindtrace.api
    mindtrace.services
    mindtrace.engines
    mindtrace.events
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.db
    mindtrace.security

[importlinter:contract:db-is-contained]
name = db depends on domain + events only: sqlalchemy/alembic confined here, never security
type = forbidden
source_modules =
    mindtrace.db
forbidden_modules =
    fastapi
    starlette
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.engines
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:security-is-contained]
name = security depends on domain only: never db (ADR-009 mutual isolation)
type = forbidden
source_modules =
    mindtrace.security
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.engines
    mindtrace.events
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.db
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:services-is-contained]
name = services depends on domain/db/security/events only: no HTTP, no orchestration/engines/llm
type = forbidden
source_modules =
    mindtrace.services
forbidden_modules =
    fastapi
    starlette
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    mindtrace.api
    mindtrace.config
    mindtrace.engines
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.observability
    mindtrace.workers
# sqlalchemy/alembic deliberately NOT listed: import-linter's `forbidden`
# contract checks the full transitive graph, and services legitimately
# depends on db.repositories, which depends on sqlalchemy - forbidding it
# here would make that legitimate edge impossible to express. "services
# never writes raw SQL itself" is a real rule, but it is a code-review
# convention (db/repositories/ is the only place SQLAlchemy constructs are
# written), not one this transitive-checking mechanism can enforce without
# also forbidding the one dependency services is supposed to have.

[importlinter:contract:api-is-contained]
name = api depends on services/security/domain only: no orchestration/engines/llm in routers
type = forbidden
source_modules =
    mindtrace.api
forbidden_modules =
    redis
    arq
    anthropic
    openai
    langchain
    mindtrace.engines
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.workers
# sqlalchemy/alembic/mindtrace.db deliberately NOT listed, same reasoning as
# services-is-contained: api legitimately depends on services, which
# legitimately depends on db - import-linter's `forbidden` contract checks
# the full transitive graph, so listing them here would forbid the one
# dependency chain this API is built on. "routers never construct SQL/ORM
# queries themselves" is enforced by code review (only db/repositories/
# constructs SQLAlchemy statements), not by this mechanism.

[importlinter:contract:provider-sdks-isolated]
name = Provider SDKs only under mindtrace.llm.providers
type = forbidden
source_modules =
    mindtrace.domain
    mindtrace.events
    mindtrace.engines
    mindtrace.orchestration
    mindtrace.api
    mindtrace.config
    mindtrace.db
    mindtrace.security
forbidden_modules =
    anthropic
    openai
    langchain
    langchain_core

[importlinter:contract:layers]
name = Layered architecture (M6-B subset)
type = layers
layers =
    mindtrace.api
    mindtrace.orchestration
    mindtrace.engines | mindtrace.events | mindtrace.llm
    mindtrace.domain
# mindtrace.db and mindtrace.security are deliberately NOT modelled in this
# strict total-order layers contract: db's one real cross-edge (db -> events,
# to implement EventStore - ADR-001) doesn't fit a layers contract's
# mutually-exclusive-siblings semantics without also permitting db -> engines/
# llm, which is not wanted. Their exact allowed edges are instead fully
# pinned by the standalone db-is-contained/security-is-contained contracts
# below (domain [+ events for db] only, and mutually isolated from each
# other per ADR-009).
