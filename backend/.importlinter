# Enforces the dependency rules in docs/architecture/01-repository-structure.md s5
# and ADR-003 (the LLM boundary). CI fails on any violation.
#
# INI format (import-linter parses `.importlinter` as INI, not TOML - a
# `pyproject.toml`-based `[tool.importlinter]` config uses TOML instead).
#
# M3 note: mindtrace.{domain,events,engines,api,config} exist now. `engines`
# alone is permitted numpy/scipy (docs/architecture/01-repository-structure.md
# s3: "engines -> domain + numpy") though M3 does not actually import it - see
# the M3 final report's "numerical precision" note. The layered contract lists
# the modules present today; expand it as services/db/... land in M4+.
#
# M5 note: mindtrace.llm exists now (ADR-003). It sits beside engines/events
# in the layered contract - depends only on domain, never on engines (it must
# not be able to make a decision) or on persistence/API layers. Only
# mindtrace.llm.providers is meant to eventually import a real provider SDK
# (provider-sdks-isolated already exempts all of mindtrace.llm by omission);
# M5 ships only a network-free fake provider, so no such import exists yet.
#
# M6-B note: mindtrace.orchestration exists now - the first layer allowed to
# import engines/llm together (it composes them; they never import it or
# each other). Still no persistence/API/frameworks: orchestration-is-
# contained forbids mindtrace.events too (no event sourcing in M6-B's
# in-memory pipeline).
#
# M6-Persistence/Foundation note: mindtrace.db and mindtrace.security exist
# now (ADR-009). Both sit in the same layer-1 tier as engines/events/llm -
# `db` is the only module permitted `sqlalchemy`/`alembic`; `security` is
# the only module (besides the future KMS adapter) permitted to touch key
# material. Per ADR-009, `db` and `security` are mutually isolated: `db`
# needs a `KeyProvider` but takes it as a Protocol parameter rather than
# importing `security.keyring` directly, so neither ever imports the other -
# db-is-contained/security-is-contained enforce this in both directions.
#
# M6-API note: mindtrace.services exists now (`memory_service`,
# `decision_service`, `auth_service`) - layer 2, coordinating `db`/
# `security`/`events` behind the HTTP boundary, and never `sqlalchemy`
# directly (SQL stays in `db/repositories/`). `mindtrace.api` gets its own
# contract for the first time too: no `sqlalchemy`/`mindtrace.db` in routers
# (`services/` is the only caller of `db/`); `security.auth` is the one
# framework-adjacent exception - token verification is an API-boundary
# concern the docs place in `security/`.
#
# M7 note: `services.decision_service` is now the one legitimate caller of
# `orchestration.simulate()` (M7 planning s3 - "reuse it, do not reproduce
# this sequence inside api/services/db"), so `mindtrace.orchestration` is no
# longer forbidden from `services-is-contained`/`api-is-contained`'s
# transitively-checked forbidden lists - same reasoning already applied to
# `sqlalchemy`/`mindtrace.db` there: forbidding a module transitively
# reachable through a legitimate direct dependency (`services ->
# orchestration`, and now `api -> services -> orchestration`) would make
# that dependency impossible to express. `mindtrace.engines`/`mindtrace.llm`
# are removed alongside it for the identical reason one layer further out
# (`orchestration -> engines`/`llm`, so `services`/`api` reach them
# transitively too the moment `services` legitimately imports
# `orchestration`) - `services` also needs `engines.preference.prior.
# initial_posterior` directly (the M7 cold-start posterior, no new math) and
# `llm.client.LLMClient` as a type (the DI seam), and `api.deps` needs
# `llm.client`/`llm.providers.unavailable` directly to construct the default
# client. "no engine math outside orchestration/engines" stays a real rule,
# enforced by the new `simulation-service-is-the-only-orchestration-caller`
# contract below rather than by the blanket module-level ban this transitive
# checker can no longer express once the one legitimate edge exists.

[importlinter]
root_package = mindtrace
include_external_packages = True

[importlinter:contract:domain-is-pure]
name = Domain is pure: no frameworks, no outward mindtrace imports
type = forbidden
source_modules =
    mindtrace.domain
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    numpy
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.engines
    mindtrace.events
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:events-is-pure]
name = Events depends only on domain: no frameworks, no outward mindtrace imports
type = forbidden
source_modules =
    mindtrace.events
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    numpy
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.engines
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:engines-is-pure]
name = Engines depend only on domain (+ numpy/scipy): no frameworks, no persistence, no LLM
type = forbidden
source_modules =
    mindtrace.engines
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.events
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:llm-is-contained]
name = LLM boundary depends only on domain: no deterministic engines, no persistence, no API
type = forbidden
source_modules =
    mindtrace.llm
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    langchain
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.engines
    mindtrace.events
    mindtrace.orchestration
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:orchestration-is-contained]
name = Orchestration depends on domain/engines/llm only: no frameworks, no persistence, no API
type = forbidden
source_modules =
    mindtrace.orchestration
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.events
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:config-is-thin]
name = Config stays thin: only depends on domain
type = forbidden
source_modules =
    mindtrace.config
forbidden_modules =
    fastapi
    sqlalchemy
    anthropic
    openai
    mindtrace.api
    mindtrace.services
    mindtrace.engines
    mindtrace.events
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.db
    mindtrace.security

[importlinter:contract:db-is-contained]
name = db depends on domain + events only: sqlalchemy/alembic confined here, never security
type = forbidden
source_modules =
    mindtrace.db
forbidden_modules =
    fastapi
    starlette
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.engines
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:security-is-contained]
name = security depends on domain only: never db (ADR-009 mutual isolation)
type = forbidden
source_modules =
    mindtrace.security
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.engines
    mindtrace.events
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.db
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:services-is-contained]
name = services depends on domain/db/security/events/orchestration only: no HTTP
type = forbidden
source_modules =
    mindtrace.services
forbidden_modules =
    fastapi
    starlette
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    mindtrace.api
    mindtrace.config
    mindtrace.observability
    mindtrace.workers
# sqlalchemy/alembic/mindtrace.orchestration/mindtrace.engines/mindtrace.llm
# deliberately NOT listed: import-linter's `forbidden` contract checks the
# full transitive graph, and services legitimately depends on
# db.repositories (-> sqlalchemy) and, since M7, on orchestration.simulate()
# (-> engines, llm) - forbidding any of them here would make those
# legitimate edges impossible to express. "services never writes raw SQL
# itself" / "no engine math outside orchestration" are real rules, but they
# are code-review conventions (db/repositories/ is the only place
# SQLAlchemy constructs are written; orchestration.simulate() is the only
# place decision_service calls into engines/llm - see the
# simulation-service-is-the-only-orchestration-caller contract below for the
# one piece of this that *is* lint-enforceable), not something this
# transitive-checking mechanism can enforce without also forbidding a
# dependency services is supposed to have.

[importlinter:contract:simulation-service-is-the-only-orchestration-caller]
name = Only decision_service may reach orchestration/engines/llm from services
type = forbidden
source_modules =
    mindtrace.services.auth_service
    mindtrace.services.memory_service
    mindtrace.services.idempotency_service
    mindtrace.services.elicitation_service
forbidden_modules =
    mindtrace.orchestration
    mindtrace.llm
# The precise version of "services never does simulation math" that the
# broader services-is-contained contract can no longer state directly (see
# its own comment): every OTHER services module stays exactly as pinned
# before M7 - auth/memory/idempotency have no business anywhere near
# orchestration, engines, or an LLM client. decision_service is deliberately
# excluded from source_modules here; it is the M7-designated
# orchestration/llm caller. elicitation_service (M8) is listed here too for
# orchestration/llm (it calls neither - no simulation, no LLM, in the
# Twin Interview flow) but is pinned separately below for `engines`, since
# it legitimately needs `engines.elicitation`/`engines.preference` while
# still having no business calling `orchestration`/an LLM client.

[importlinter:contract:elicitation-service-engines-scope]
name = elicitation_service may reach engines (preference/elicitation only), never orchestration/llm
type = forbidden
source_modules =
    mindtrace.services.auth_service
    mindtrace.services.memory_service
    mindtrace.services.idempotency_service
forbidden_modules =
    mindtrace.engines
# A second, narrower pass at the same guarantee: unlike the contract above
# (which also covers elicitation_service for orchestration/llm),
# `mindtrace.engines` itself is only forbidden from auth/memory/idempotency
# here - elicitation_service legitimately depends on
# `engines.preference.interview`/`engines.preference.update`/
# `engines.elicitation.*` (M8's fixed-order interview math, already M4's own
# code, never duplicated) and is deliberately excluded from source_modules.

[importlinter:contract:api-is-contained]
name = api depends on services/security/domain only: no HTTP-adjacent 3rd parties
type = forbidden
source_modules =
    mindtrace.api
forbidden_modules =
    redis
    arq
    anthropic
    openai
    langchain
    mindtrace.workers
# sqlalchemy/alembic/mindtrace.db/mindtrace.llm/mindtrace.orchestration/
# mindtrace.engines deliberately NOT listed: import-linter's `forbidden`
# contract checks the full transitive graph, and api legitimately depends on
# services, which legitimately depends on db (M6-Persistence) and, since M7,
# on orchestration (-> engines) - forbidding any of them here would make
# those legitimate edges impossible to express (confirmed empirically:
# listing `mindtrace.orchestration`/`mindtrace.engines` here breaks the
# contract on the real `api.routers.decisions -> services.decision_service
# -> orchestration/engines.confidence.compute` edge). `mindtrace.llm` is
# additionally a *direct* api dependency: `api/deps.py` builds the default
# `LLMClient` (`llm.providers.unavailable.UnavailableLLMClient`) for
# dependency injection - the same reason `security.auth` was already
# exempted. "routers never construct SQL/ORM queries or call engines/
# orchestration themselves" is enforced by code review (only
# db/repositories/ constructs SQLAlchemy statements; only decision_service
# calls orchestration.simulate() - see
# simulation-service-is-the-only-orchestration-caller above), not by this
# mechanism, where every one of these dependencies is transitively
# legitimate.

[importlinter:contract:provider-sdks-isolated]
name = Provider SDKs only under mindtrace.llm.providers
type = forbidden
source_modules =
    mindtrace.domain
    mindtrace.events
    mindtrace.engines
    mindtrace.orchestration
    mindtrace.api
    mindtrace.config
    mindtrace.db
    mindtrace.security
forbidden_modules =
    anthropic
    openai
    langchain
    langchain_core

[importlinter:contract:layers]
name = Layered architecture (M6-B subset)
type = layers
layers =
    mindtrace.api
    mindtrace.orchestration
    mindtrace.engines | mindtrace.events | mindtrace.llm
    mindtrace.domain
# mindtrace.db and mindtrace.security are deliberately NOT modelled in this
# strict total-order layers contract: db's one real cross-edge (db -> events,
# to implement EventStore - ADR-001) doesn't fit a layers contract's
# mutually-exclusive-siblings semantics without also permitting db -> engines/
# llm, which is not wanted. Their exact allowed edges are instead fully
# pinned by the standalone db-is-contained/security-is-contained contracts
# below (domain [+ events for db] only, and mutually isolated from each
# other per ADR-009).
