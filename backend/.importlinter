# Enforces the dependency rules in docs/architecture/01-repository-structure.md s5
# and ADR-003 (the LLM boundary). CI fails on any violation.
#
# INI format (import-linter parses `.importlinter` as INI, not TOML - a
# `pyproject.toml`-based `[tool.importlinter]` config uses TOML instead).
#
# M3 note: mindtrace.{domain,events,engines,api,config} exist now. `engines`
# alone is permitted numpy/scipy (docs/architecture/01-repository-structure.md
# s3: "engines -> domain + numpy") though M3 does not actually import it - see
# the M3 final report's "numerical precision" note. The layered contract lists
# the modules present today; expand it as services/db/... land in M4+.

[importlinter]
root_package = mindtrace
include_external_packages = True

[importlinter:contract:domain-is-pure]
name = Domain is pure: no frameworks, no outward mindtrace imports
type = forbidden
source_modules =
    mindtrace.domain
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    numpy
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.engines
    mindtrace.events
    mindtrace.llm
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:events-is-pure]
name = Events depends only on domain: no frameworks, no outward mindtrace imports
type = forbidden
source_modules =
    mindtrace.events
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    numpy
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.engines
    mindtrace.llm
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:engines-is-pure]
name = Engines depend only on domain (+ numpy/scipy): no frameworks, no persistence, no LLM
type = forbidden
source_modules =
    mindtrace.engines
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.events
    mindtrace.llm
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:config-is-thin]
name = Config stays thin: only depends on domain
type = forbidden
source_modules =
    mindtrace.config
forbidden_modules =
    fastapi
    sqlalchemy
    anthropic
    openai
    mindtrace.api
    mindtrace.services
    mindtrace.engines
    mindtrace.events
    mindtrace.llm
    mindtrace.db

[importlinter:contract:provider-sdks-isolated]
name = Provider SDKs only under mindtrace.llm.providers
type = forbidden
source_modules =
    mindtrace.domain
    mindtrace.events
    mindtrace.engines
    mindtrace.api
    mindtrace.config
forbidden_modules =
    anthropic
    openai
    langchain
    langchain_core

[importlinter:contract:layers]
name = Layered architecture (M3 subset)
type = layers
layers =
    mindtrace.api
    mindtrace.engines | mindtrace.events
    mindtrace.domain
