# Enforces the dependency rules in docs/architecture/01-repository-structure.md s5
# and ADR-003 (the LLM boundary). CI fails on any violation.
#
# INI format (import-linter parses `.importlinter` as INI, not TOML - a
# `pyproject.toml`-based `[tool.importlinter]` config uses TOML instead).
#
# M3 note: mindtrace.{domain,events,engines,api,config} exist now. `engines`
# alone is permitted numpy/scipy (docs/architecture/01-repository-structure.md
# s3: "engines -> domain + numpy") though M3 does not actually import it - see
# the M3 final report's "numerical precision" note. The layered contract lists
# the modules present today; expand it as services/db/... land in M4+.
#
# M5 note: mindtrace.llm exists now (ADR-003). It sits beside engines/events
# in the layered contract - depends only on domain, never on engines (it must
# not be able to make a decision) or on persistence/API layers. Only
# mindtrace.llm.providers is meant to eventually import a real provider SDK
# (provider-sdks-isolated already exempts all of mindtrace.llm by omission);
# M5 ships only a network-free fake provider, so no such import exists yet.
#
# M6-B note: mindtrace.orchestration exists now - the first layer allowed to
# import engines/llm together (it composes them; they never import it or
# each other). Still no persistence/API/frameworks: orchestration-is-
# contained forbids mindtrace.events too (no event sourcing in M6-B's
# in-memory pipeline).

[importlinter]
root_package = mindtrace
include_external_packages = True

[importlinter:contract:domain-is-pure]
name = Domain is pure: no frameworks, no outward mindtrace imports
type = forbidden
source_modules =
    mindtrace.domain
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    numpy
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.engines
    mindtrace.events
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:events-is-pure]
name = Events depends only on domain: no frameworks, no outward mindtrace imports
type = forbidden
source_modules =
    mindtrace.events
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    numpy
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.engines
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:engines-is-pure]
name = Engines depend only on domain (+ numpy/scipy): no frameworks, no persistence, no LLM
type = forbidden
source_modules =
    mindtrace.engines
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.events
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:llm-is-contained]
name = LLM boundary depends only on domain: no deterministic engines, no persistence, no API
type = forbidden
source_modules =
    mindtrace.llm
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    langchain
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.engines
    mindtrace.events
    mindtrace.orchestration
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:orchestration-is-contained]
name = Orchestration depends on domain/engines/llm only: no frameworks, no persistence, no API
type = forbidden
source_modules =
    mindtrace.orchestration
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    redis
    arq
    anthropic
    openai
    langchain
    httpx
    httpx2
    mindtrace.api
    mindtrace.config
    mindtrace.services
    mindtrace.events
    mindtrace.db
    mindtrace.security
    mindtrace.observability
    mindtrace.workers

[importlinter:contract:config-is-thin]
name = Config stays thin: only depends on domain
type = forbidden
source_modules =
    mindtrace.config
forbidden_modules =
    fastapi
    sqlalchemy
    anthropic
    openai
    mindtrace.api
    mindtrace.services
    mindtrace.engines
    mindtrace.events
    mindtrace.llm
    mindtrace.orchestration
    mindtrace.db

[importlinter:contract:provider-sdks-isolated]
name = Provider SDKs only under mindtrace.llm.providers
type = forbidden
source_modules =
    mindtrace.domain
    mindtrace.events
    mindtrace.engines
    mindtrace.orchestration
    mindtrace.api
    mindtrace.config
forbidden_modules =
    anthropic
    openai
    langchain
    langchain_core

[importlinter:contract:layers]
name = Layered architecture (M6-B subset)
type = layers
layers =
    mindtrace.api
    mindtrace.orchestration
    mindtrace.engines | mindtrace.events | mindtrace.llm
    mindtrace.domain
