  "traits": {
    "disposition_credible_interval": 0.9,
    "dispositions": [
      {
        "description": "General willingness to accept a worse-case outcome in exchange for a better expected or best-case outcome.",
        "id": "risk_tolerance",
        "inferable_from": [
          "interview_risk_items",
          "observed_choices_between_safe_and_risky_options",
          "stated_risk_attitude"
        ],
        "kind": "latent",
        "mechanical_effect": "Sets the exponent of the `downside_risk` cost curve and the `financial_security` benefit curve at normalization time (spec/05 s2): gamma = k_risk ^ (2*risk_tolerance - 1), k_risk = 1.7. risk_tolerance 0.5 -> gamma 1 (linear); 0 -> gamma 0.59 (amplifies risk badness and security value); 1 -> gamma 1.7 (dampens both). Symmetric about the neutral point.",
        "prior": {
          "alpha": 2.0,
          "beta": 2.0
        }
      },
      {
        "description": "How steeply the person discounts payoffs that are far in the future relative to near ones. HIGH = present-focused; LOW = patient.",
        "id": "time_discount",
        "inferable_from": [
          "interview_intertemporal_items",
          "observed_choices_between_now_and_later_payoffs"
        ],
        "kind": "latent",
        "mechanical_effect": "Read-time multiplier on `long_term_value` and `option_value` contributions: m = 1 - 0.6 * time_discount. Also scales the \"Future You\" parallel-twin shift magnitude (ADR-007): larger when time_discount is high (more room to move the person toward patience).",
        "prior": {
          "alpha": 2.5,
          "beta": 2.0
        }
      },
      {
        "description": "Discomfort with unknown or unquantifiable outcomes (as opposed to known risky ones).",
        "id": "ambiguity_aversion",
        "inferable_from": [
          "interview_ambiguity_items",
          "observed_preference_for_trial_periods",
          "hedging_in_past_decisions"
        ],
        "kind": "latent",
        "mechanical_effect": "Raises the effective weight of `reversibility` and tightens the UNCERTAIN coverage gate for this user: COVERAGE_MIN_user = COVERAGE_MIN + 0.15 * ambiguity_aversion.",
        "prior": {
          "alpha": 2.5,
          "beta": 2.0
        }
      },
      {
        "description": "Willingness to sustain high time and energy demand in exchange for gains on other factors.",
        "id": "effort_tolerance",
        "inferable_from": [
          "interview_effort_items",
          "observed_acceptance_of_demanding_options",
          "burnout_history"
        ],
        "kind": "latent",
        "mechanical_effect": "Sets the `time_demand` cost curve exponent: gamma = k_effort ^ (2*effort_tolerance - 1), k_effort = 1.6. effort_tolerance 0.5 -> gamma 1; 0 -> gamma 0.625 (time demand feels heavier); 1 -> gamma 1.6 (more tolerant).",
        "prior": {
          "alpha": 2.0,
          "beta": 2.0
        }
      }
