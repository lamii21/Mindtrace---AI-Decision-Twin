{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindtrace.local/schema/interview.schema.json",
  "title": "MINDTRACE Twin Interview item bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "released", "factor_schema_version", "config", "pairwise", "disposition"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "released": { "type": "string", "format": "date" },
    "factor_schema_version": { "type": "integer", "minimum": 1 },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "likert_warmup_factors", "fixed_prefix_items", "adaptive_suffix_max",
        "target_total", "logistic_scale_s", "pseudocount_kappa", "consistency_check_item_ids"
      ],
      "properties": {
        "likert_warmup_factors": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
        "fixed_prefix_items": { "type": "integer", "minimum": 0 },
        "adaptive_suffix_max": { "type": "integer", "minimum": 0 },
        "target_total": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 }
        },
        "logistic_scale_s": { "type": "number", "exclusiveMinimum": 0 },
        "pseudocount_kappa": { "type": "number", "exclusiveMinimum": 0 },
        "consistency_check_item_ids": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } }
      }
    },
    "pairwise": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pairwiseItem" }
    },
    "disposition": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dispositionItem" }
    }
  },
  "$defs": {
    "levelCode": { "enum": ["vl", "l", "m", "h", "vh"] },
    "profile": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/levelCode" }
    },
    "pairwiseItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt_A", "prompt_B", "A", "B", "covers"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "prompt_A": { "type": "string", "minLength": 1 },
        "prompt_B": { "type": "string", "minLength": 1 },
        "A": { "$ref": "#/$defs/profile" },
        "B": { "$ref": "#/$defs/profile" },
        "covers": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
        "role": { "const": "consistency_check" }
      }
    },
    "dispositionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "type", "prompt_A", "prompt_B"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "target": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "type": { "enum": ["gamble", "intertemporal", "ambiguity", "effort"] },
        "prompt_A": { "type": "string", "minLength": 1 },
        "prompt_B": { "type": "string", "minLength": 1 },
        "risky_option": { "enum": ["A", "B"] },
        "patient_option": { "enum": ["A", "B"] },
        "ambiguity_seeking_option": { "enum": ["A", "B"] },
        "high_effort_option": { "enum": ["A", "B"] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "gamble" } } }, "then": { "required": ["risky_option"] } },
        { "if": { "properties": { "type": { "const": "intertemporal" } } }, "then": { "required": ["patient_option"] } },
        { "if": { "properties": { "type": { "const": "ambiguity" } } }, "then": { "required": ["ambiguity_seeking_option"] } },
        { "if": { "properties": { "type": { "const": "effort" } } }, "then": { "required": ["high_effort_option"] } }
      ]
    }
  }
}
