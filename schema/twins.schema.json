{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MINDTRACE parallel twin transforms",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "factor_schema_version", "lambda", "twins"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "factor_schema_version": { "type": "integer", "minimum": 1 },
    "lambda": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "twins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "up", "down"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 },
          "up": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "down": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
